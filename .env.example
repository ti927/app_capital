# Copie para .env e preencha. O .env NÃO vai para o git.
# Nunca cole valor de chave no chat nem em documento versionado — cite o nome da variável.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor. Ignora RLS por completo — nunca exponha ao navegador,
# nunca use em componente client, nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `npx supabase link --project-ref`
SUPABASE_PROJECT_REF=

# Dashboard > Project Settings > Database > Connection string
# Use a string do pooler (porta 6543) para a aplicação e a direta (5432) para migrations.
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Bubble — só para a extração de dados da migração
# ---------------------------------------------------------------------------
# Rotacionar assim que o corte for feito (docs/fluxo-de-trabalho.md).
BUBBLE_API_KEY=
BUBBLE_APP_URL=https://<seu-app>.bubbleapps.io

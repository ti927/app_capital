# Copie para .env e preencha. O .env NÃO vai para o git.
# Nunca cole valor de chave no chat nem em documento versionado — cite o nome da variável.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor. Ignora RLS por completo — nunca exponha ao navegador,
# nunca use em componente client, nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `npx supabase link --project-ref`
SUPABASE_PROJECT_REF=

# Dashboard > Project Settings > Database > Connection string.
# Atenção: neste projeto o host direto `db.<ref>.supabase.co` não resolve
# (sem IPv4). Use as strings do pooler:
#   6543 = transaction mode, para a aplicação
#   5432 = session mode, para migrations
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:<porta>/postgres
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Entrada
# ---------------------------------------------------------------------------
# A tela de entrada é só Google. `1` mostra também o formulário de e-mail e
# senha — é por ele que `npm run qa` e a medição entram. Só no .env local;
# nunca na Vercel.
ENTRADA_COM_SENHA=

# ---------------------------------------------------------------------------
# Google Agenda — tarefa de reunião vira evento (specs/11-google-agenda.md)
# ---------------------------------------------------------------------------
# Os mesmos Client ID e Secret do provedor Google no Supabase. Só servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64; cifra os tokens em google_conexao. Tem que
# ser a MESMA da Vercel, senão o local não lê o que produção gravou:
#   npx vercel env pull .env.vercel   (e copie a linha para o .env)
GOOGLE_TOKEN_CHAVE=

# ---------------------------------------------------------------------------
# E-mail de status da operação — Resend (specs/13-email.md). Só servidor.
# ---------------------------------------------------------------------------
# Chave de envio do Resend.
RESEND_API_KEY=
# Remetente num domínio verificado no Resend, ex.: Lure Capital <capital@dominio>
EMAIL_REMETENTE=
# Cópia oculta fixa de todo envio para o cliente (como no Bubble).
EMAIL_COPIA_OCULTA=

# ---------------------------------------------------------------------------
# Bubble — só para a extração de dados da migração
# ---------------------------------------------------------------------------
# Rotacionar assim que o corte for feito (docs/seguranca.md).
BUBBLE_API_KEY=
BUBBLE_APP_URL=https://<seu-app>.bubbleapps.io

# ---------------------------------------------------------------------------
# Sincronização com o Bubble — botão de dev (specs/10-sincronizacao-bubble.md)
# ---------------------------------------------------------------------------
# Usa BUBBLE_API_KEY e BUBBLE_APP_URL acima. Todas de servidor: nunca
# prefixe com NEXT_PUBLIC_.
#
# E-mail da única conta que vê o botão e pode rodar a sincronização (precisa
# ser master ativa). Vazio = ninguém pode.
SINCRONIZACAO_EMAIL=
# Raiz do Bubble lida pelo botão: `live` (padrão, quando vazio) ou
# `version-test`.
BUBBLE_SINCRONIZACAO_RAIZ=
